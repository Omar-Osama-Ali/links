<link href="https://fonts.googleapis.com/css2?family=General+Sans:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
:root{
    --bg:#f5f2eb;
    --surface:#ffffff;
    --surface-2:#f8f8f6;
    --text:#1b1b1b;
    --muted:#666;
    --border:#dfdfda;
    --accent:#4e6b47;
    --accent-hover:#40593a;
    --shadow:0 10px 30px rgba(0,0,0,.07);
    --radius:22px;
}

[data-theme="dark"]{
    --bg:#101212;
    --surface:#191b1b;
    --surface-2:#202424;
    --text:#f3f3f1;
    --muted:#a0a0a0;
    --border:#343636;
    --accent:#85a87e;
    --accent-hover:#97ba90;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:"IBM Plex Sans",sans-serif;
    background:
        linear-gradient(rgba(0,0,0,.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,0,0,.03) 1px, transparent 1px),
        var(--bg);
    background-size:32px 32px,32px 32px,auto;
    color:var(--text);
    min-height:100vh;
    line-height:1.6;
    overflow-x:hidden;
}

/* Progress Bar */
.progress{
    position:fixed;
    top:0;
    left:0;
    width:0%;
    height:4px;
    background:var(--accent);
    z-index:9999;
}

/* Skip Link */
.skip-link{
    position:absolute;
    left:-9999px;
}

.skip-link:focus{
    left:16px;
    top:16px;
    background:white;
    padding:12px;
    z-index:999;
}

/* Layout */
.container{
    max-width:760px;
    margin:auto;
    padding:32px 20px 100px;
}

.hero{
    text-align:center;
    padding:50px 0 30px;
}

.avatar{
    width:120px;
    height:120px;
    margin:auto;
    border-radius:50%;
    display:grid;
    place-items:center;
    background:var(--surface);
    border:1px solid var(--border);
    box-shadow:var(--shadow);
    font-size:42px;
    font-weight:700;
    color:var(--accent);
}

h1{
    font-family:"IBM Plex Sans",sans-serif;
    font-size:clamp(2.4rem,5vw,4rem);
    margin-top:22px;
    letter-spacing:-0.04em;
}

.subtitle{
    color:var(--muted);
    margin-top:10px;
    font-size:1.05rem;
}

.description{
    max-width:600px;
    margin:20px auto 0;
    color:var(--muted);
}

/* Top Actions */

.primary-actions{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
    margin-top:30px;
}

.btn{
    border:none;
    cursor:pointer;
    text-decoration:none;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:10px;
    min-height:56px;
    border-radius:16px;
    transition:.2s ease;
    font-weight:600;
}

.btn:hover{
    transform:translateY(-2px);
}

.btn:active{
    transform:scale(.97);
}

.btn-primary{
    background:var(--accent);
    color:white;
}

.btn-secondary{
    background:var(--surface);
    border:1px solid var(--border);
    color:var(--text);
}

/* Cards */

.links{
    margin-top:36px;
    display:grid;
    gap:14px;
}

.card{
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--radius);
    padding:18px;
    text-decoration:none;
    color:inherit;
    display:flex;
    justify-content:space-between;
    align-items:center;
    transition:.22s ease;
    box-shadow:var(--shadow);
}

.card:hover{
    transform:translateY(-4px);
}

.card-left h3{
    font-size:1.05rem;
    margin-bottom:4px;
}

.card-left p{
    color:var(--muted);
    font-size:.95rem;
}

.arrow{
    font-size:1.3rem;
    color:var(--accent);
}

/* Contact */

.contact{
    margin-top:40px;
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--radius);
    padding:24px;
    box-shadow:var(--shadow);
}

.contact h2{
    margin-bottom:18px;
}

.contact-item{
    display:flex;
    justify-content:space-between;
    gap:10px;
    align-items:center;
    padding:14px 0;
    border-bottom:1px solid var(--border);
}

.contact-item:last-child{
    border-bottom:none;
}

.mono{
    font-family:"IBM Plex Mono",monospace;
    font-variant-numeric:tabular-nums;
}

.copy-btn{
    border:none;
    background:var(--surface-2);
    color:var(--text);
    padding:10px 14px;
    border-radius:12px;
    cursor:pointer;
}

.copy-btn:active{
    transform:scale(.97);
}

/* Footer */

footer{
    text-align:center;
    padding-top:40px;
    color:var(--muted);
}

/* Floating Button */

.floating{
    position:fixed;
    right:20px;
    bottom:20px;
    width:58px;
    height:58px;
    border-radius:50%;
    background:var(--accent);
    color:white;
    border:none;
    cursor:pointer;
    box-shadow:0 15px 35px rgba(0,0,0,.2);
    text-decoration:none;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:1.4rem;
}

/* Theme */

.theme-toggle{
    position:fixed;
    right:20px;
    top:20px;
    z-index:99;
    width:46px;
    height:46px;
    border-radius:50%;
    border:1px solid var(--border);
    background:var(--surface);
    cursor:pointer;
}

/* Toast */

.toast{
    position:fixed;
    left:50%;
    bottom:100px;
    transform:translateX(-50%) translateY(20px);
    background:var(--text);
    color:var(--bg);
    padding:12px 16px;
    border-radius:12px;
    opacity:0;
    pointer-events:none;
    transition:.25s ease;
}

.toast.show{
    opacity:1;
    transform:translateX(-50%) translateY(0);
}

/* Mobile */

@media(max-width:640px){

.primary-actions{
    grid-template-columns:1fr;
}

.contact-item{
    flex-direction:column;
    align-items:flex-start;
}

}
</style>
</head>

