        /* Tabular numbers for phone/numbers */
        .tabular {
            font-variant-numeric: tabular-nums;
            letter-spacing: 0.05em;
        }

        /* Copy Button */
        .copy-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            padding: 8px;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
