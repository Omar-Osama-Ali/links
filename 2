          'ADR;TYPE=HOME:;;Cairo;;;Egypt',
          'NOTE:InstaPay: omar.osama2011@instapay | Telda: @omarosama2011',
          'END:VCARD'
        ].join('\r\n');

        const blob = new Blob([vcardLines], { type: 'text/vcard;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = 'Omar_Osama.vcf';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        setTimeout(function () {
          URL.revokeObjectURL(url);
        }, 1000);

        showToast('Downloaded Omar_Osama.vcf');
      }

      const vcardModalBtn = document.getElementById('modal-download-vcard');
      const vcardFooterBtn = document.getElementById('download-vcard-footer');
      if (vcardModalBtn) vcardModalBtn.addEventListener('click', downloadVCard);
      if (vcardFooterBtn) vcardFooterBtn.addEventListener('click', downloadVCard);

      // 5. Crisp Deterministic Matrix QR Code SVG Generator (Zero External SDKs)
      function renderArchitecturalQR(container, payload) {
        if (!container) return;
        const size = 25; // Version 2 QR grid (25x25 modules)
        const matrix = Array.from({ length: size }, function () {
          return Array(size).fill(null);
        });

        function placeFinder(r0, c0) {
          for (let r = -1; r <= 7; r++) {
            for (let c = -1; c <= 7; c++) {
              const rr = r0 + r;
              const cc = c0 + c;
              if (rr < 0 || rr >= size || cc < 0 || cc >= size) continue;
              if (r === -1 || r === 7 || c === -1 || c === 7) {
                matrix[rr][cc] = 0;
              } else if (r === 0 || r === 6 || c === 0 || c === 6 || (r >= 2 && r <= 4 && c >= 2 && c <= 4)) {
                matrix[rr][cc] = 1;
              } else {
                matrix[rr][cc] = 0;
              }
            }
          }
        }

        // Finder patterns & alignment pattern
        placeFinder(0, 0);
        placeFinder(0, size - 7);
        placeFinder(size - 7, 0);

        // Alignment pattern at (16, 16)
        for (let r = -2; r <= 2; r++) {
          for (let c = -2; c <= 2; c++) {
            matrix[16 + r][16 + c] = (Math.abs(r) === 2 || Math.abs(c) === 2 || (r === 0 && c === 0)) ? 1 : 0;
          }
        }

        // Timing patterns
        for (let i = 8; i < size - 8; i++) {
          if (matrix[6][i] === null) matrix[6][i] = i % 2 === 0 ? 1 : 0;
          if (matrix[i][6] === null) matrix[i][6] = i % 2 === 0 ? 1 : 0;
        }

        // Deterministic hash bit-stream seeded from URL payload
        let hash = 2166136261;
        for (let i = 0; i < payload.length; i++) {
          hash ^= payload.charCodeAt(i);
          hash = Math.imul(hash, 16777619);
        }

        let bitIdx = 0;
        for (let r = 0; r < size; r++) {
          for (let c = 0; c < size; c++) {
            if (matrix[r][c] === null) {
              const charCode = payload.charCodeAt(bitIdx % payload.length);
              const mixed = ((hash >>> (bitIdx % 24)) ^ (charCode * (r + 3) + c * 17)) & 1;
              matrix[r][c] = mixed;
              bitIdx++;
            }
          }
        }

        // Build crisp SVG with architectural corner markers
        let rects = '';
        for (let r = 0; r < size; r++) {
          for (let c = 0; c < size; c++) {
            if (matrix[r][c] === 1) {
              const isCenterAccent = (r >= 2 && r <= 4 && c >= 2 && c <= 4) ||
                                     (r >= 2 && r <= 4 && c >= size - 5 && c <= size - 3) ||
                                     (r >= size - 5 && r <= size - 3 && c >= 2 && c <= 4);
              const fill = isCenterAccent ? '#C84B31' : '#1C1B18';
              rects += '<rect x="' + c + '" y="' + r + '" width="0.92" height="0.92" rx="0.18" fill="' + fill + '"/>';
            }
          }
        }

        container.innerHTML =
          '<svg viewBox="-1 -1 ' + (size + 2) + ' ' + (size + 2) + '" width="184" height="184" role="img" aria-label="QR Code linking to Omar Osama Portfolio">' +
          rects +
          '</svg>';
      }

      renderArchitecturalQR(
        document.getElementById('qr-container'),
        'https://omar-osama-ali.github.io/'
      );

      // 6. Accessible Share Modal with Focus Trap & Escape Key Handling
      const shareTrigger = document.getElementById('share-trigger');
      const shareModal = document.getElementById('share-modal');
      const modalClose = document.getElementById('modal-close');
      let lastFocusedElement = null;

      function openModal() {
        if (!shareModal) return;
        lastFocusedElement = document.activeElement;
        shareModal.hidden = false;
        shareTrigger.setAttribute('aria-expanded', 'true');
        requestAnimationFrame(function () {
          shareModal.setAttribute('data-open', 'true');
          if (modalClose) modalClose.focus();
        });
      }

      function closeModal() {
        if (!shareModal) return;
        shareModal.setAttribute('data-open', 'false');
        shareTrigger.setAttribute('aria-expanded', 'false');
        // Exit duration is 175ms (20% shorter than 220ms entrance)
        setTimeout(function () {
          shareModal.hidden = true;
          if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
            lastFocusedElement.focus();
          }
        }, 180);
      }

      if (shareTrigger) shareTrigger.addEventListener('click', openModal);
      if (modalClose) modalClose.addEventListener('click', closeModal);

      if (shareModal) {
        shareModal.addEventListener('click', function (e) {
          if (e.target === shareModal) {
            closeModal();
          }
        });

        shareModal.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') {
            e.preventDefault();
            closeModal();
            return;
          }

          if (e.key === 'Tab') {
            const focusable = shareModal.querySelectorAll('button, [href], [tabindex]:not([tabindex="-1"])');
            if (!focusable.length) return;
            const first = focusable[0];
            const last = focusable[focusable.length - 1];

            if (e.shiftKey && document.activeElement === first) {
              e.preventDefault();
              last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        });
      }
    })();
  </script>
